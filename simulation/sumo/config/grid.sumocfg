<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <input>
        <net-file value="../network/grid.net.xml"/>
        <route-files value="../routes/grid.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="200"/>
    </time>

    <processing>
        <time-to-teleport value="-1"/>
    </processing>

    <report>
        <verbose value="true"/>
        <duration-log.disable value="false"/>
    </report>

</configuration>