<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <input>
        <net-file value="../network/ecotwin.net.xml"/>
        <route-files value="../routes/ecotwin.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="1000"/>
        <step-length value="1"/>
    </time>

    <processing>
        <time-to-teleport value="300"/>
    </processing>

    <output>
        <tripinfo-output value="../../data/raw/tripinfo.xml"/>
        <emission-output value="../../data/raw/emissions.xml"/>
    </output>

    <report>
        <verbose value="true"/>
        <no-step-log value="true"/>
    </report>

</configuration>